generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon's pooled endpoint (`-pooler`). PgBouncer in transaction mode, which is
  // what the app wants: short-lived queries, no session state.
  url       = env("DATABASE_URL")
  // Migrations need session state (advisory locks, DDL transactions) that the
  // pooler drops, so Migrate/db push/db pull go straight to the compute endpoint
  // — the same host without `-pooler`. Never read at runtime; the Docker build
  // runs `prisma generate` with neither var set and doesn't need them.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  // Steam is the only auth method
  steamId      String    @unique
  username     String
  avatarUrl    String?
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  fcmToken     String?
  // Language for push notifications ("es", "pt-BR"…), sent by the app with the
  // FCM token. Null for app versions that predate it — they get English.
  locale       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  watchlist WatchlistItem[]
  alerts    Alert[]
  portfolio PortfolioItem[]
  purchases Purchase[]

  @@index([steamId])
}

// One row per Google Play purchase that unlocked premium. Exists so a token can
// be bound to the first account that claims it (Play records no obfuscated
// account ID for promo-code redemptions), and so a refund can be traced back to
// the account it unlocked: `revokeVoidedPurchases` matches Play's voided
// purchases against `purchaseToken`. One row per buyer — negligible storage.
model Purchase {
  id            String    @id @default(cuid())
  userId        String
  purchaseToken String    @unique
  orderId       String?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Skin {
  id             String   @id
  name           String
  marketHashName String   @unique
  weapon         String
  rarity         String
  iconUrl        String
  createdAt      DateTime @default(now())

  price        SkinPrice?
  priceHistory PriceHistory[]
  // No onDelete: a skin users hold alerts, watchlist entries or portfolio
  // items for can't be deleted out from under them (Restrict).
  watchlist    WatchlistItem[]
  alerts       Alert[]
  portfolio    PortfolioItem[]

  @@index([weapon])
  @@index([rarity])
}

model SkinPrice {
  id              String   @id @default(cuid())
  skinId          String   @unique
  // Three bulk-public marketplaces — each refreshed every 6h via a single HTTP call.
  // No API keys, no rate-limit issues (4 requests/day per marketplace).
  skinportPrice   Float? // api.skinport.com (USD)
  csgoMarketPrice Float? // market.csgo.com (USD)
  waxpeerPrice    Float? // api.waxpeer.com (USD)
  lowestPrice     Float?
  volume24h       Int?
  priceChange24h  Float? // cached %, recomputed during each price refresh job
  updatedAt       DateTime @updatedAt

  skin Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([priceChange24h(sort: Desc)])
  @@index([lowestPrice])
}

model PriceHistory {
  id        String   @id @default(cuid())
  skinId    String
  price     Float
  source    String   @default("steam")
  timestamp DateTime @default(now())

  skin Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([skinId, timestamp])
  // Serves the 24h-change reference query, which filters on `timestamp` alone
  // (the composite index above is keyed on skinId first and can't serve it).
  @@index([timestamp])
}

model WatchlistItem {
  id              String   @id @default(cuid())
  userId          String
  skinId          String
  targetBuyPrice  Float?
  targetSellPrice Float?
  alertEnabled    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin Skin @relation(fields: [skinId], references: [id])

  @@unique([userId, skinId])
  @@index([userId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  skinId      String
  type        AlertType
  targetPrice Float
  isActive    Boolean   @default(true)
  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin Skin @relation(fields: [skinId], references: [id])

  @@index([userId])
  @@index([isActive])
}

enum AlertType {
  BUY_BELOW
  SELL_ABOVE
}

model PortfolioItem {
  id           String   @id @default(cuid())
  userId       String
  skinId       String
  assetId      String
  float        Float?
  acquirePrice Float
  acquiredAt   DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skin Skin @relation(fields: [skinId], references: [id])

  @@unique([userId, assetId])
  @@index([userId])
}
