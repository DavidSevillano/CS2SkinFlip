generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  // Steam is the only auth method
  steamId      String    @unique
  username     String
  avatarUrl    String?
  isPremium    Boolean   @default(false)
  premiumUntil DateTime?
  fcmToken     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  watchlist WatchlistItem[]
  alerts    Alert[]
  portfolio PortfolioItem[]

  @@index([steamId])
}

model Skin {
  id             String   @id
  name           String
  marketHashName String   @unique
  weapon         String
  rarity         String
  iconUrl        String
  createdAt      DateTime @default(now())

  price        SkinPrice?
  priceHistory PriceHistory[]

  @@index([weapon])
  @@index([rarity])
}

model SkinPrice {
  id              String   @id @default(cuid())
  skinId          String   @unique
  // Three bulk-public marketplaces — each refreshed every 2h via a single HTTP call.
  // No API keys, no rate-limit issues (12 requests/day per marketplace).
  skinportPrice   Float?   // api.skinport.com (USD)
  csgoMarketPrice Float?   // market.csgo.com (USD)
  waxpeerPrice    Float?   // api.waxpeer.com (USD)
  lowestPrice     Float?
  volume24h       Int?
  priceChange24h  Float?   // cached %, recomputed during each price refresh job
  updatedAt       DateTime @updatedAt

  skin Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([priceChange24h(sort: Desc)])
  @@index([lowestPrice])
}

model PriceHistory {
  id        String   @id @default(cuid())
  skinId    String
  price     Float
  source    String   @default("steam")
  timestamp DateTime @default(now())

  skin Skin @relation(fields: [skinId], references: [id], onDelete: Cascade)

  @@index([skinId, timestamp])
  // Serves the 24h-change reference query, which filters on `timestamp` alone
  // (the composite index above is keyed on skinId first and can't serve it).
  @@index([timestamp])
}

model WatchlistItem {
  id              String   @id @default(cuid())
  userId          String
  skinId          String
  targetBuyPrice  Float?
  targetSellPrice Float?
  alertEnabled    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skinId])
  @@index([userId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  skinId      String
  type        AlertType
  targetPrice Float
  isActive    Boolean   @default(true)
  isTriggered Boolean   @default(false)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

enum AlertType {
  BUY_BELOW
  SELL_ABOVE
}

model PortfolioItem {
  id           String   @id @default(cuid())
  userId       String
  skinId       String
  assetId      String
  float        Float?
  acquirePrice Float
  acquiredAt   DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([userId])
}
