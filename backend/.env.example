# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL (Neon, Supabase, Railway, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/cs2skinflip?schema=public"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# JWT (min 32 chars)
JWT_SECRET="change-me-to-a-very-long-random-secret-string"

# Steam
STEAM_API_KEY="your-steam-api-key"
STEAM_CALLBACK_URL="http://localhost:3000/auth/steam/callback"

# Frontend (for CORS + redirects after OAuth)
FRONTEND_URL="http://localhost:8080"
