<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and lower (API 31+ reads data_extraction_rules.xml).
  Keep the two files in sync.

  Excluded: credentials that would become a live session on whatever device the
  backup is restored to.
    - datastore/auth_prefs.preferences_pb: the backend JWT (TokenDataStore).
    - app_webview: the WebView cookie jar, which holds the Steam Community session
      (steamLoginSecure) from SteamLoginScreen.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth_prefs.preferences_pb" />
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
